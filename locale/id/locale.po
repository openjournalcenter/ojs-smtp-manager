msgstr "Uji Diagnostik SMTP OJS - {$date}"

msgid "plugins.generic.smtpManager.test.emailBody"
msgstr "Ini adalah email uji coba otomatis yang dikirim oleh plugin SMTP Manager OJS.\n\nHost SMTP: {$host}\nPort SMTP: {$port}\nWaktu Kirim: {$date}\n\nJika Anda membaca email ini, pengaturan SMTP kustom dan koneksi TLS/SSL jurnal Anda telah berhasil dikonfigurasi dan berfungsi dengan baik."

msgid "plugins.generic.smtpManager.test.senderName"
msgstr "Uji SMTP OJS"

